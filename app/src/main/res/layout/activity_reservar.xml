<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sabor_cream"
    android:padding="24dp"
    android:fitsSystemWindows="true">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reservar Mesa"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/sabor_black_text"
        android:layout_marginBottom="24dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
    <EditText
        android:id="@+id/etFecha"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Selecciona una fecha"
        android:focusable="false"
        android:background="@drawable/bg_search"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hora"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
    <Spinner
        android:id="@+id/spinnerHora"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_search"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personas"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">
        <Button
            android:id="@+id/btnMenos"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="-"
            android:textSize="20sp"/>
        <TextView
            android:id="@+id/tvPersonas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2 personas"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/btnMas"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="+"
            android:textSize="20sp"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarReserva"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Confirmar Reserva"
        android:textSize="16sp"
        app:backgroundTint="@color/sabor_green_dark"/>
</LinearLayout>
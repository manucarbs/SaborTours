<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sabor_cream"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Administración"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/sabor_black_text"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="Aquí verás las reservaciones de tus clientes para aceptarlas o rechazarlas."
        android:textColor="@color/sabor_gray_text"/>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sabor_cream"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/ivDetalleImagen"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvDetalleNombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/sabor_black_text"/>
                <ImageButton
                    android:id="@+id/btnFavorito"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Marcar como favorito"
                    android:src="@drawable/ic_favorito_off"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvDetalleInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sabor_gray_text"
                android:layout_marginTop="4dp"/>
            <TextView
                android:id="@+id/tvDetalleEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
            <TextView
                android:id="@+id/tvDetalleDireccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sabor_gray_text"
                android:layout_marginTop="2dp"/>
            <TextView
                android:id="@+id/tvDetalleRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/sabor_green_dark"
                android:layout_marginTop="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sobre este lugar"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>
            <TextView
                android:id="@+id/tvDetalleDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sabor_gray_text"
                android:layout_marginTop="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menú"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>
            <TextView
                android:id="@+id/tvMenuVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Este negocio aún no ha publicado su menú"
                android:textColor="@color/sabor_gray_text"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicación"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>
            <FrameLayout
                android:id="@+id/contenedorMapa"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvSinUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Este negocio aún no registró su ubicación."
                android:textColor="@color/sabor_gray_text"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComoLlegar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cómo llegar"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reseñas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscribirResena"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Escribir reseña"/>
            <TextView
                android:id="@+id/tvSinResenas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aún no hay reseñas. ¡Sé el primero!"
                android:textColor="@color/sabor_gray_text"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResenas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReservarMesa"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Reservar Mesa"
                android:textSize="16sp"
                app:backgroundTint="@color/sabor_green_dark"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>